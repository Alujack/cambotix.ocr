{
  "name": "@khmerocr/client",
  "version": "0.1.0",
  "description": "TypeScript client for the KhmerOCR REST API: Cambodian ID card extraction and Khmer/English OCR.",
  "license": "Apache-2.0",
  "author": "Yoeurn Yan",
  "homepage": "https://github.com/Alujack/cambotix.ocr/tree/master/packages/sdk-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alujack/cambotix.ocr.git",
    "directory": "packages/sdk-typescript"
  },
  "bugs": "https://github.com/Alujack/cambotix.ocr/issues",
  "keywords": ["ocr", "khmer", "cambodia", "id-card", "kyc", "khmerocr"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
